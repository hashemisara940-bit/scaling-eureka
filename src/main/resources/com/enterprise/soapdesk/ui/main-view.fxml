<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.fxmisc.richtext.CodeArea?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <VBox fx:id="sidebar" prefWidth="220" styleClass="sidebar">
            <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>
            <Button text="☰" onAction="#toggleSidebar" styleClass="ghost-button"/>
            <Button text="Dashboard" styleClass="sidebar-item"/>
            <Button text="SOAP Requests" styleClass="sidebar-item"/>
            <Button text="WSDL Imports" styleClass="sidebar-item"/>
            <Button text="Variables" styleClass="sidebar-item"/>
            <Button text="Load Tests" styleClass="sidebar-item"/>
            <Button text="Reports" styleClass="sidebar-item"/>
            <Button text="Settings" styleClass="sidebar-item"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10" styleClass="content-pane">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="SoapDesk Enterprise" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Import WSDL File" onAction="#importWsdlFile" styleClass="primary"/>
                <Button text="Import WSDL URL" onAction="#importWsdlUrl" styleClass="secondary"/>
                <Button text="Execute" onAction="#executeSoap" styleClass="primary"/>
            </HBox>
            <SplitPane dividerPositions="0.28,0.72" VBox.vgrow="ALWAYS">
                <VBox spacing="8">
                    <Label text="WSDL Structure"/>
                    <ProgressIndicator fx:id="wsdlProgress" visible="false" maxWidth="28" maxHeight="28"/>
                    <TreeView fx:id="wsdlTree" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Endpoint"/>
                    <TextField fx:id="endpointField"/>
                    <Label text="SOAP Action"/>
                    <TextField fx:id="soapActionField"/>
                    <Label text="Request XML"/>
                    <CodeArea fx:id="requestArea" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button text="Prettify" onAction="#prettifyXml"/>
                        <Button text="Clear" onAction="#clearRequest"/>
                    </HBox>
                </VBox>
                <VBox spacing="8">
                    <Label text="Response XML"/>
                    <CodeArea fx:id="responseArea" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button text="Copy" onAction="#copyResponse"/>
                        <Label fx:id="metadataLabel" text="Status: Idle"/>
                    </HBox>
                </VBox>
            </SplitPane>
            <Label fx:id="statusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>
